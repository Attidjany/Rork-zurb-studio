PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zurb
DB_USER=root
DB_PASS=
JWT_SECRET=change-me
# Public URL of the web app (used in password-reset emails)
SITE_URL=https://zurbstudio.zenoah.org
# Anthropic (AI scenario generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional SMTP for password-reset emails (link is logged to stdout when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZURB Studio <no-reply@zenoah.org>"
# Optional: serve the exported web app from this directory (local dev / single-process hosting)
STATIC_DIR=
